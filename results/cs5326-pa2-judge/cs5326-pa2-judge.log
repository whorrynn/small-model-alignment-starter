,{"stream_name":"stdout","time":1898.230033159,"data":"\n"}
,{"stream_name":"stdout","time":1898.231036125,"data":"This will install the `typescript` package, which is required for TypeScript development.\n"}
,{"stream_name":"stdout","time":1898.232072007,"data":"\n"}
